{
  "manifest_version": 3,
  "name": "YouTube Personal Downloader",
  "version": "1.6.1",
  "description": "ดาวน์โหลดวิดีโอหรือเสียงที่คุณมีสิทธิ์บันทึก ผ่านโปรแกรมบนเครื่อง",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "video-url.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.6.1 (2026-11-18)"
}
